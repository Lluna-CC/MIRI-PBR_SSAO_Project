####### Compile

release/triangle_mesh.o: triangle_mesh.cc triangle_mesh.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o release/triangle_mesh.o triangle_mesh.cc

release/mesh_io.o: mesh_io.cc mesh_io.h \
		triangle_mesh.h \
		tiny_obj_loader.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o release/mesh_io.o mesh_io.cc

release/main.o: main.cc main_window.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o release/main.o main.cc

release/main_window.o: main_window.cc main_window.h \
		release/ui_main_window.h \
		glwidget.h \
		camera.h \
		triangle_mesh.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o release/main_window.o main_window.cc

release/glwidget.o: glwidget.cc glwidget.h \
		camera.h \
		triangle_mesh.h \
		mesh_io.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o release/glwidget.o glwidget.cc

release/camera.o: camera.cc camera.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o release/camera.o camera.cc

release/tiny_obj_loader.o: tiny_obj_loader.cc tiny_obj_loader.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o release/tiny_obj_loader.o tiny_obj_loader.cc

release/moc_main_window.o: release/moc_main_window.cpp 
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o release/moc_main_window.o release/moc_main_window.cpp

release/moc_glwidget.o: release/moc_glwidget.cpp 
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o release/moc_glwidget.o release/moc_glwidget.cpp

